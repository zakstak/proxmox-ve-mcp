{
  "name": "proxmox-ve-mcp",
  "version": "1.0.0",
  "description": "Skills-first Proxmox VE onboarding for OpenCode with a read-only default and legacy MCP runtime compatibility",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:readonly": "tsx watch src/index-readonly.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:readonly": "node dist/index-readonly.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "proxmox",
    "opencode",
    "skills",
    "legacy-mcp",
    "mcp",
    "model-context-protocol",
    "virtualization",
    "homelab"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.7",
    "proxmox-api": "^1.1.1",
    "undici": "^8.12.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
